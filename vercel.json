{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-jewelleryshop.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://backend-jewelleryshop.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
} 